# =============================================================================
# SWE-Forge configuration template
#
# Copy to `.env` and fill in. NEVER commit `.env` — it is gitignored.
# Every value below is a placeholder. No real credential belongs in this file.
#
#   cp .env.example .env
#
# SWE-Forge runs without any of these set: the test suite, `sweforge analyze`
# and `sweforge demo` all work with zero credentials. Model credentials are
# needed only for `sweforge run` against a real task.
# =============================================================================

# -----------------------------------------------------------------------------
# Model provider credentials (needed only for live runs)
# Supply the provider(s) matching the model tiers configured below.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-key-here
# OPENAI_API_KEY=your-openai-key-here
# GOOGLE_API_KEY=your-google-key-here
# FIREWORKS_API_KEY=your-fireworks-key-here

# -----------------------------------------------------------------------------
# SWE-Forge adaptive model routing
#
# The router selects a TIER per role, then resolves the tier to a model id.
# Ids use LangChain's "provider:model" form and are never hard-coded in source.
#   fast      -> cheap bookkeeping: complexity priors, summarisation
#   balanced  -> failure analysis
#   coding    -> implementation and repair
#   reasoning -> planning, review, security analysis
# -----------------------------------------------------------------------------
SWEFORGE_MODEL_FAST=anthropic:claude-haiku-4-5-20251001
SWEFORGE_MODEL_BALANCED=anthropic:claude-sonnet-4-5
SWEFORGE_MODEL_CODING=anthropic:claude-sonnet-4-5
SWEFORGE_MODEL_REASONING=anthropic:claude-opus-4-1

# -----------------------------------------------------------------------------
# Cost accounting (USD per 1M tokens, "input,output")
# Used by the model usage ledger to estimate run cost. Adjust to your pricing.
# -----------------------------------------------------------------------------
# SWEFORGE_PRICE_FAST=1.00,5.00
# SWEFORGE_PRICE_BALANCED=3.00,15.00
# SWEFORGE_PRICE_CODING=3.00,15.00
# SWEFORGE_PRICE_REASONING=15.00,75.00

# -----------------------------------------------------------------------------
# Execution safety
#
# SWEFORGE_ALLOW_LOCAL_EXEC=1 permits running repository code on THIS HOST.
# It exists for SWE-Forge's own checked-in evaluation fixtures only. For any
# real repository use the Open SWE sandbox backend instead: repository code is
# untrusted by definition, and the sandbox is the isolation boundary.
# -----------------------------------------------------------------------------
# SWEFORGE_ALLOW_LOCAL_EXEC=1

# -----------------------------------------------------------------------------
# Experience memory (retrieval-based planning context; not model training)
# -----------------------------------------------------------------------------
# SWEFORGE_MEMORY_PATH=.sweforge/experience.jsonl

# -----------------------------------------------------------------------------
# LangSmith observability (entirely optional)
# Tracing activates only when BOTH the switch and a key are present, so
# leaving these unset is a supported, fully-functional configuration.
# -----------------------------------------------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-key-here
# LANGSMITH_PROJECT=sweforge
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# =============================================================================
# Upstream Open SWE settings
#
# SWE-Forge does not replace Open SWE's own configuration. When running the
# upstream application (GitHub App, sandbox providers, Slack/Linear
# integrations), consult the upstream README and set those variables here too.
# SWE-Forge reads none of them directly.
# =============================================================================
